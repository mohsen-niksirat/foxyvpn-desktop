<?xml version="1.0" encoding="utf-8"?>
<!--
  The home-screen widget's button, off: a white shield (the app's sign)
  on a round disc shaded in the state's color, with a soft halo; inside the
  shield, a power sign. Gradients need API 24, the app's minSdk.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="96dp"
    android:height="96dp"
    android:viewportWidth="96"
    android:viewportHeight="96">
    <!-- The halo. -->
    <path
        android:fillColor="#33737A94"
        android:pathData="M48,1a47,47 0,1 1,0 94a47,47 0,1 1,0 -94z" />
    <!-- The disc, lighter at the top left. -->
    <path android:pathData="M48,4a44,44 0,1 1,0 88a44,44 0,1 1,0 -88z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="17"
                android:startY="8"
                android:endX="79"
                android:endY="88"
                android:startColor="#FFA3A9BF"
                android:endColor="#FF4B5168" />
        </aapt:attr>
    </path>
    <!-- A soft shine on the upper half. -->
    <path android:pathData="M48,6c-21,0 -37.5,13 -39.5,31c11,-9 24,-13 39.5,-13s28.5,4 39.5,13c-2,-18 -18.5,-31 -39.5,-31z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="48"
                android:startY="6"
                android:endX="48"
                android:endY="37"
                android:startColor="#40FFFFFF"
                android:endColor="#00FFFFFF" />
        </aapt:attr>
    </path>
    <!-- The shield (Material's, scaled to 42 x 53). -->
    <group
        android:translateX="16.8"
        android:translateY="15.15"
        android:scaleX="2.6"
        android:scaleY="2.6">
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M12,2L4,5v6c0,5.25 3.4,10.15 8,11.5c4.6,-1.35 8,-6.25 8,-11.5V5L12,2z" />
    </group>
    <group
        android:translateX="34.8"
        android:translateY="33.3"
        android:scaleX="1.1"
        android:scaleY="1.1">
        <path
            android:fillColor="#FF4B5168"
            android:pathData="M13,3h-2v10h2L13,3zM17.83,5.17l-1.42,1.42C17.99,7.86 19,9.81 19,12c0,3.87 -3.13,7 -7,7s-7,-3.13 -7,-7c0,-2.19 1.01,-4.14 2.58,-5.42L6.17,5.17C4.23,6.82 3,9.26 3,12c0,4.97 4.03,9 9,9s9,-4.03 9,-9c0,-2.74 -1.23,-5.18 -3.17,-6.83z" />
    </group>
</vector>
